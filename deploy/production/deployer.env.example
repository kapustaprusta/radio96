# Copy this file to .env.production.deployer on the production VM.
# It contains deployment metadata only. Secret values stay in Lockbox.
RADIO96_GITHUB_REPOSITORY=owner/radio96
RADIO96_GITHUB_WORKFLOW=deploy-production.yml
RADIO96_REPOSITORY_DIR=/home/yc-user/radio96
RADIO96_PRODUCTION_ENV_FILE=/home/yc-user/radio96/.env.production
RADIO96_DEPLOYER_STATE_DIR=/home/yc-user/.local/state/radio96

RADIO96_SITE_URL=https://radio96.example.com
RADIO96_SITE_ADDRESS=radio96.example.com
RADIO96_ACME_EMAIL=admin@example.com
RADIO96_IMAGE_PREFIX=cr.yandex/replace-with-registry-id
RADIO96_PLATFORM=linux/amd64
RADIO96_HTTP_PORT=80
RADIO96_HTTPS_PORT=443

RADIO96_DATABASE_HOST=c-replace-with-cluster-id.rw.mdb.yandexcloud.net
RADIO96_DATABASE_PORT=6432
RADIO96_DATABASE_NAME=radio96
RADIO96_DATABASE_USER=radio96
RADIO96_DATABASE_SECRET_ID=replace-with-lockbox-secret-id
RADIO96_DATABASE_PASSWORD_NAME=postgresql_password
RADIO96_DATABASE_CA_FILE=/home/yc-user/radio96/.secrets/yandex-cloud-ca.pem
RADIO96_DATABASE_CA_URL=https://storage.yandexcloud.net/cloud-certs/CA.pem

RADIO96_LIVEKIT_SECRET_ID=replace-with-lockbox-secret-id
RADIO96_LIVEKIT_URL_NAME=LIVEKIT_URL
RADIO96_LIVEKIT_API_KEY_NAME=LIVEKIT_API_KEY
RADIO96_LIVEKIT_API_SECRET_NAME=LIVEKIT_API_SECRET

RADIO96_YC_PROFILE=radio96-runtime
RADIO96_DATABASE_CONNECT_TIMEOUT=5s
RADIO96_MEDIA_REQUEST_TIMEOUT=5s
RADIO96_SHUTDOWN_TIMEOUT=10s
