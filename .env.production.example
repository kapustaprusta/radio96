# Public endpoint. Use http://localhost for a local smoke test of the production stack.
PRODUCTION_SITE_ADDRESS=radio96.example.com
PRODUCTION_ACME_EMAIL=admin@example.com
PRODUCTION_HTTP_PORT=80
PRODUCTION_HTTPS_PORT=443
PRODUCTION_PLATFORM=linux/amd64

# Use cr.yandex/<registry-id> in Yandex Container Registry and one immutable
# release tag for all images. Set the tag to the full Git commit SHA.
PRODUCTION_IMAGE_PREFIX=localhost
PRODUCTION_RELEASE_TAG=replace-with-full-git-sha

# Managed PostgreSQL. Percent-encode special characters in the password.
# Keep sslrootcert equal to the container path below, not the host path.
PRODUCTION_DATABASE_URL='postgres://user:password@c-id.rw.mdb.yandexcloud.net:6432/db?sslmode=verify-full&sslrootcert=/yc-ca.pem'
PRODUCTION_DATABASE_CA_FILE=.secrets/yandex-cloud-ca.pem
PRODUCTION_DATABASE_CONNECT_TIMEOUT=5s

# LiveKit Cloud credentials are backend-only and must be set together.
PRODUCTION_LIVEKIT_URL=wss://replace-me.livekit.cloud
PRODUCTION_LIVEKIT_API_KEY=replace-me
PRODUCTION_LIVEKIT_API_SECRET=replace-me
PRODUCTION_MEDIA_REQUEST_TIMEOUT=5s

PRODUCTION_SHUTDOWN_TIMEOUT=10s
